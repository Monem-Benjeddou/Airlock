{
  "version": "2026.10.1",
  "rules": [
    {"id": "sig.unsigned", "category": "signature", "level": "high",
     "when": {"signatureStatus": ["unsigned"]},
     "message": "The app is not signed, so nobody can vouch for who made it."},
    {"id": "sig.invalid", "category": "signature", "level": "high",
     "when": {"signatureStatus": ["invalid"]},
     "message": "The app's signature does not match its contents. It was changed after it was signed."},
    {"id": "sig.unverifiable", "category": "signature", "level": "medium",
     "when": {"signatureStatus": ["unverifiable"]},
     "message": "Airlock could not verify this app's signature."},
    {"id": "sig.differs-installed", "category": "signature", "level": "high",
     "when": {"signerMatch": ["differsFromInstalled"]},
     "message": "It is signed by a different developer than the copy already on your phone. This is how fake updates usually look."},
    {"id": "sig.differs-official", "category": "signature", "level": "high",
     "when": {"signerMatch": ["differsFromKnownOfficial"]},
     "message": "It is signed by a different developer than the official version of this app."},
    {"id": "sig.debug-certificate", "category": "signature", "level": "medium",
     "when": {"debugCertificate": true},
     "message": "It is signed with a developer test certificate, not a release certificate."},

    {"id": "perm.sms-and-overlay", "group": "sms", "category": "permissions", "level": "high",
     "when": {"anyPermission": ["android.permission.READ_SMS", "android.permission.RECEIVE_SMS"],
              "allPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]},
     "message": "It can read your text messages and draw over other apps, a combination common in banking malware."},
    {"id": "perm.sms-unexpected", "group": "sms", "category": "permissions", "level": "high",
     "when": {"anyPermission": ["android.permission.READ_SMS", "android.permission.RECEIVE_SMS", "android.permission.SEND_SMS"],
              "appCategory": ["game", "media", "utility"]},
     "message": "A {category} app asking to read or send text messages is unusual."},
    {"id": "perm.sms", "group": "sms", "category": "permissions", "level": "medium",
     "when": {"anyPermission": ["android.permission.READ_SMS", "android.permission.RECEIVE_SMS", "android.permission.SEND_SMS"]},
     "message": "It can read or send text messages, including one-time login codes."},
    {"id": "perm.call-log", "category": "permissions", "level": "medium",
     "when": {"anyPermission": ["android.permission.READ_CALL_LOG", "android.permission.PROCESS_OUTGOING_CALLS"]},
     "message": "It can read your call history or see the numbers you dial."},
    {"id": "perm.accessibility", "category": "permissions", "level": "medium",
     "when": {"anyPermission": ["android.permission.BIND_ACCESSIBILITY_SERVICE"]},
     "message": "It can read your screen and tap on your behalf if you enable its accessibility service."},
    {"id": "perm.install-packages", "category": "permissions", "level": "medium",
     "when": {"anyPermission": ["android.permission.REQUEST_INSTALL_PACKAGES"]},
     "message": "It can install other apps."},
    {"id": "perm.all-files", "category": "permissions", "level": "medium",
     "when": {"anyPermission": ["android.permission.MANAGE_EXTERNAL_STORAGE"]},
     "message": "It can read and change all files on your shared storage."},
    {"id": "perm.background-location", "category": "permissions", "level": "medium",
     "when": {"anyPermission": ["android.permission.ACCESS_BACKGROUND_LOCATION"]},
     "message": "It can track your location even when you are not using it."},
    {"id": "perm.many-dangerous", "category": "permissions", "level": "medium",
     "when": {"dangerousPermissionCountAtLeast": 12},
     "message": "It asks for {count} sensitive permissions, more than most apps need."},

    {"id": "rep.malicious-many", "category": "reputation", "level": "high",
     "when": {"maliciousAtLeast": 3},
     "message": "{malicious} antivirus engines on VirusTotal flag this file as malicious."},
    {"id": "rep.malicious-few", "category": "reputation", "level": "medium",
     "when": {"maliciousAtLeast": 1, "maliciousBelow": 3},
     "message": "{malicious} antivirus engine(s) on VirusTotal flag this file as malicious. A small number can be a false alarm."},
    {"id": "rep.suspicious", "category": "reputation", "level": "medium",
     "when": {"suspiciousAtLeast": 1, "maliciousBelow": 1},
     "message": "{suspicious} antivirus engine(s) on VirusTotal find this file suspicious."},

    {"id": "trk.many", "category": "trackers", "level": "medium",
     "when": {"trackerCountAtLeast": 6},
     "message": "It contains {trackers} tracking or advertising libraries."},
    {"id": "trk.some", "category": "trackers", "level": "low",
     "when": {"trackerCountAtLeast": 1, "trackerCountBelow": 6},
     "message": "It contains {trackers} tracking or advertising library(ies)."},

    {"id": "man.debuggable", "category": "manifest", "level": "medium",
     "when": {"debuggable": true},
     "message": "It is built for debugging, not as a finished release."},
    {"id": "man.old-target", "category": "manifest", "level": "medium",
     "when": {"targetSdkBelow": 23},
     "message": "It targets a very old Android version, which lets it skip permission prompts."},
    {"id": "man.test-only", "category": "manifest", "level": "low",
     "when": {"testOnly": true},
     "message": "It is marked as a test build."}
  ]
}
